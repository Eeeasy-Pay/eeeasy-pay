{
  "name": "eeeasy-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Simulator-only P2P payments and bill-splitting product orchestration layer. NOT a live payment product.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
